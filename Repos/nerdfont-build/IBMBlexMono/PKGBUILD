pkgname=IBMBlexMono
pkgver=3.1.1
pkgrel=1
pkgdesc="IBMPlexMono Nerd Font"
arch=('any')
url="https://www.nerdfonts.com/"
license=('custom:nerd-font')
source=("https://github.com/ryanoasis/nerd-fonts/releases/download/v3.3.0/IBMPlexMono.zip")
sha256sums=('SKIP')

package() {
	install -dm755 "$pkgdir/usr/share/fonts/nerd-fonts"
	install -m644 *.ttf "$pkgdir/usr/share/fonts/nerd-fonts/"
}
